[Unit]
Description=Webinterface für Cloudflared
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cloudflared-webui/app
Environment=PYTHONUNBUFFERED=1
Environment=CFWEBUI_PORT=8099
ExecStart=/usr/bin/python3 /opt/cloudflared-webui/app/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
